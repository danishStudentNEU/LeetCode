class Solution:
    def bstFromPreorder(self, preorder: List[int]) -> Optional[TreeNode]:
        inorder = sorted(preorder)
        def helper(preorder,inorder):
            if not preorder and not inorder:
                return None
            root = TreeNode(preorder[0])
            index_of_root_inorder = inorder.index(preorder[0])
            left_boundary = inorder[0:index_of_root_inorder]
            right_boundary = inorder[index_of_root_inorder+1: len(inorder)]
            preorder_left = preorder[1:len(left_boundary)+1]
            inorder_left = left_boundary
            root.left = helper(preorder_left,inorder_left)
            preorder_right = preorder[len(preorder_left)+1:len(preorder)]
            inorder_right = right_boundary
            root.right = helper(preorder_right,inorder_right)
            return root
        root = helper(preorder,inorder)
        return root
